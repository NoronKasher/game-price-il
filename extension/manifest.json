{
  "manifest_version": 3,
  "name": "VGPT.IL — משווה מחירי משחקים",
  "description": "השוואת מחירי משחקים לישראל — דיגיטלי, פיזי ובין אזורים. רץ כולו בדפדפן, בלי שרת.",
  "version": "0.2.0",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "VGPT.IL"
  },
  "permissions": [
    "storage",
    "alarms",
    "unlimitedStorage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://www.cheapshark.com/*",
    "https://store.steampowered.com/*",
    "https://api.egdata.app/*",
    "https://store.epicgames.com/*",
    "https://www.ea.com/*",
    "https://store.ubisoft.com/*",
    "https://displaycatalog.mp.microsoft.com/*",
    "https://www.xbox.com/*",
    "https://search.nintendo-europe.com/*",
    "https://api.ec.nintendo.com/*",
    "https://www.nintendo.com/*",
    "https://*.vgs.co.il/*",
    "https://*.player1.co.il/*",
    "https://*.arcadia.co.il/*",
    "https://*.gamestorm.co.il/*",
    "https://*.ivory.co.il/*",
    "https://*.bug.co.il/*",
    "https://web.np.playstation.com/*",
    "https://store.playstation.com/*",
    "https://api.gg.deals/*",
    "https://api.isthereanydeal.com/*",
    "https://www.gog.com/*",
    "https://catalog.gamepass.com/*",
    "https://api.steampowered.com/*",
    "https://steamcommunity.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "identify",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://noronkasher.github.io/game-price-il/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.amazon.com/*",
        "https://www.amazon.co.uk/*",
        "https://www.amazon.de/*",
        "https://www.amazon.fr/*",
        "https://www.amazon.es/*",
        "https://www.amazon.it/*",
        "https://www.amazon.ca/*",
        "https://www.amazon.com.au/*",
        "https://www.amazon.co.jp/*",
        "https://www.amazon.pl/*",
        "https://www.amazon.se/*",
        "https://www.amazon.nl/*",
        "https://www.amazon.ae/*",
        "https://www.amazon.sa/*",
        "https://www.amazon.sg/*"
      ],
      "js": [
        "amazon.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://store.steampowered.com/app/*",
        "https://www.gog.com/*/game/*",
        "https://www.gog.com/game/*",
        "https://www.xbox.com/*/games/store/*",
        "https://store.playstation.com/*/product/*",
        "https://www.nintendo.com/*/store/products/*",
        "https://store.epicgames.com/*/p/*"
      ],
      "js": [
        "storepage.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
